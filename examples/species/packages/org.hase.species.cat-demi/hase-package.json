{
  "$schema": "../../../../docs/03-specifications/schemas/package.schema.json",
  "schemaVersion": "1.0",
  "id": "org.hase.species.cat-demi",
  "type": "species",
  "version": "1.0.0",
  "name": {
    "de": "Katzen-Demi"
  },
  "description": "Menschliches Gesicht, Katzenohren und -schwanz als Bodyparts mit Spring-Chains.",
  "authors": [
    "HASE VRM MAKER"
  ],
  "tags": [
    "humanoid",
    "demi"
  ],
  "license": {
    "spdx": "CC0-1.0",
    "attribution": null,
    "redistribution": true
  },
  "requires": [
    {
      "id": "org.hase.body.humanoid-mh08",
      "range": "^1.0"
    },
    {
      "id": "org.hase.asset.bodypart.cat-ears",
      "range": "^1.0"
    },
    {
      "id": "org.hase.asset.bodypart.cat-tail",
      "range": "^1.0"
